{
  "name": "strudel-studio",
  "version": "1.0.0",
  "description": "Desktop Live-Coding Studio utilisant le moteur Strudel avec interface 100% sur-mesure",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build:editor": "esbuild node_modules/@strudel/codemirror/dist/index.mjs --bundle --outfile=src/ui/codemirror-bundle.js --format=esm",
    "build:linux": "electron-builder --linux AppImage",
    "dist": "electron-builder",
    "install-shortcut": "bash scripts/install-shortcut.sh"
  },
  "keywords": [
    "strudel",
    "tidalcycles",
    "live-coding",
    "desktop",
    "electron",
    "webaudio"
  ],
  "author": "Hugo Birard",
  "license": "AGPL-3.0",
  "dependencies": {
    "@strudel/codemirror": "^1.3.0",
    "@strudel/web": "^1.3.0"
  },
  "devDependencies": {
    "electron": "^40.0.0",
    "esbuild": "^0.28.2"
  },
  "build": {
    "appId": "com.hugobirard.strudel-studio",
    "productName": "Strudel Studio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "assets/icon.svg",
      "category": "AudioVideo"
    }
  }
}
